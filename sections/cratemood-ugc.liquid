{{ 'component-slider.css' | asset_url | stylesheet_tag }}
{{ 'section-cratemood-ugc.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  #CrateMoodUgc-{{ section.id }} {
    --cratemood-ugc-cols: {{ section.settings.columns_desktop }};
  }
{%- endstyle -%}

<div class="color-{{ section.settings.color_scheme }} gradient">
  <div
    id="CrateMoodUgc-{{ section.id }}"
    class="page-width section-{{ section.id }}-padding cratemood-ugc{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
  >
    <div class="cratemood-ugc__head">
      {%- if section.settings.heading != blank -%}
        <h2 class="cratemood-ugc__heading {{ section.settings.heading_size }}">{{ section.settings.heading | escape }}</h2>
      {%- endif -%}
      {%- if section.settings.subheading != blank -%}
        <p class="cratemood-ugc__subheading">{{ section.settings.subheading | escape }}</p>
      {%- endif -%}
    </div>

    <slider-component class="cratemood-ugc__slider">
      <ul
        id="Slider-{{ section.id }}"
        class="cratemood-ugc__track"
        role="list"
        aria-label="{{ section.settings.heading | escape }}"
      >
        {%- for block in section.blocks -%}
          <li
            id="Slide-{{ section.id }}-{{ forloop.index }}"
            class="cratemood-ugc__item slider__slide"
            {{ block.shopify_attributes }}
          >
            {%- if block.settings.link != blank -%}
              <a class="cratemood-ugc__link" href="{{ block.settings.link }}" target="_blank" rel="noopener">
            {%- endif -%}
              {% render 'cratemood-image',
                image: block.settings.image,
                fallback: block.settings.fallback_asset,
                class: 'cratemood-ugc__image',
                widths: '300, 450, 600, 750',
                sizes: '(min-width: 750px) 33vw, 78vw',
                alt: section.settings.heading
              %}
            {%- if block.settings.link != blank -%}</a>{%- endif -%}
          </li>
        {%- endfor -%}
      </ul>

      {%- if section.blocks.size > 1 -%}
        <div class="slider-buttons cratemood-ugc__buttons">
          <button
            type="button"
            class="slider-button slider-button--prev"
            name="previous"
            aria-label="Previous photo"
            aria-controls="Slider-{{ section.id }}"
          >
            <span class="svg-wrapper">
              {{- 'icon-caret.svg' | inline_asset_content -}}
            </span>
          </button>
          <button
            type="button"
            class="slider-button slider-button--next"
            name="next"
            aria-label="Next photo"
            aria-controls="Slider-{{ section.id }}"
          >
            <span class="svg-wrapper">
              {{- 'icon-caret.svg' | inline_asset_content -}}
            </span>
          </button>
        </div>
      {%- endif -%}
    </slider-component>

    {%- if section.settings.button_label != blank -%}
      <div class="cratemood-ugc__cta">
        <a
          class="button button--secondary"
          {% if section.settings.button_link == blank %}role="link" aria-disabled="true"{% else %}href="{{ section.settings.button_link }}"{% endif %}
        >
          {{ section.settings.button_label | escape }}
        </a>
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "CrateMood UGC",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "REAL PETS. REAL MOODS."
    },
    {
      "type": "select",
      "id": "heading_size",
      "options": [
        { "value": "h2", "label": "Medium" },
        { "value": "h1", "label": "Large" },
        { "value": "h0", "label": "Extra large" }
      ],
      "default": "h1",
      "label": "Heading size"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "See how pet people are using CrateMood."
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 2,
      "max": 5,
      "step": 1,
      "label": "Columns on desktop",
      "default": 3
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Follow @cratemood"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Section padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 48
    }
  ],
  "blocks": [
    {
      "type": "post",
      "name": "Post",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "fallback_asset",
          "label": "Placeholder asset (fallback)",
          "info": "Theme asset filename shown only when no image is chosen."
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "max_blocks": 24,
  "presets": [
    {
      "name": "CrateMood UGC",
      "blocks": [
        { "type": "post", "settings": { "fallback_asset": "cratemood-real-lifestyle-willow.jpg" } },
        { "type": "post", "settings": { "fallback_asset": "cratemood-real-lifestyle-wall.jpg" } },
        { "type": "post", "settings": { "fallback_asset": "cratemood-real-lifestyle-moose.jpg" } }
      ]
    }
  ]
}
{% endschema %}
