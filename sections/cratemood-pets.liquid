{{ 'section-cratemood-pets.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  #CrateMoodPets-{{ section.id }} {
    --cratemood-pets-cols: {{ section.settings.columns_desktop }};
    --cratemood-pets-cols-mobile: {{ section.settings.columns_mobile }};
  }
{%- endstyle -%}

<div class="color-{{ section.settings.color_scheme }} gradient">
  <div
    id="CrateMoodPets-{{ section.id }}"
    class="page-width section-{{ section.id }}-padding cratemood-pets{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
  >
    <div class="cratemood-pets__head">
      {%- if section.settings.eyebrow != blank -%}
        <p class="cratemood-pets__eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="cratemood-pets__heading {{ section.settings.heading_size }}">{{ section.settings.heading | escape }}</h2>
      {%- endif -%}
    </div>

    <ul class="cratemood-pets__grid" role="list">
      {%- for block in section.blocks -%}
        <li class="cratemood-pet-card" {{ block.shopify_attributes }}>
          {%- if block.settings.link != blank -%}<a class="cratemood-pet-card__link" href="{{ block.settings.link }}">{%- endif -%}
            <div class="cratemood-pet-card__media">
              {% render 'cratemood-image',
                image: block.settings.image,
                fallback: block.settings.fallback_asset,
                class: 'cratemood-pet-card__image',
                widths: '300, 450, 600, 750',
                sizes: '(min-width: 990px) 25vw, (min-width: 750px) 33vw, 50vw',
                alt: block.settings.title
              %}
            </div>
            <div class="cratemood-pet-card__body">
              {%- if block.settings.title != blank -%}
                <h3 class="cratemood-pet-card__title">{{ block.settings.title | escape }}</h3>
              {%- endif -%}
              {%- if block.settings.text != blank -%}
                <p class="cratemood-pet-card__text">{{ block.settings.text | escape }}</p>
              {%- endif -%}
            </div>
          {%- if block.settings.link != blank -%}</a>{%- endif -%}
        </li>
      {%- endfor -%}
    </ul>
  </div>
</div>

{% schema %}
{
  "name": "CrateMood pets",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "FOR EVERY PERSONALITY"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Made for every pet"
    },
    {
      "type": "select",
      "id": "heading_size",
      "options": [
        { "value": "h2", "label": "Medium" },
        { "value": "h1", "label": "Large" },
        { "value": "h0", "label": "Extra large" }
      ],
      "default": "h1",
      "label": "Heading size"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 2,
      "max": 4,
      "step": 1,
      "label": "Columns on desktop",
      "default": 4
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "options": [
        { "value": "1", "label": "1 column" },
        { "value": "2", "label": "2 columns" }
      ],
      "default": "2",
      "label": "Columns on mobile"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Section padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 48
    }
  ],
  "blocks": [
    {
      "type": "pet",
      "name": "Pet",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "fallback_asset",
          "label": "Placeholder asset (fallback)",
          "info": "Theme asset filename shown only when no image is chosen."
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Dogs"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "From crate signs to kennel tags for pups of every size."
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [
    {
      "name": "CrateMood pets",
      "blocks": [
        { "type": "pet", "settings": { "title": "Dogs", "fallback_asset": "cratemood-real-lifestyle-moose.jpg", "text": "From crate signs to kennel tags for pups of every size." } },
        { "type": "pet", "settings": { "title": "Cats", "fallback_asset": "cratemood-pets-cat.jpg", "text": "Mini tiles made for carriers, shelves, baskets and cozy corners." } },
        { "type": "pet", "settings": { "title": "Rabbits & small pets", "fallback_asset": "cratemood-pets-rabbit.jpg", "text": "Hutches, cages and enclosures for rabbits and more." } },
        { "type": "pet", "settings": { "title": "Every other pet", "fallback_asset": "cratemood-pets-other.jpg", "text": "If they have a personality, they deserve a mood." } }
      ]
    }
  ]
}
{% endschema %}
